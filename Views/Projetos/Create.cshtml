@model TechChallenge.Models.Projeto

@{
    ViewData["Title"] = "Create";
}

<div style="background-color:#F5F1E8; min-height:100vh; padding:30px;">

<h1 style="color:#D8B4F8;">Create</h1>

<h4 style="color:#A8D8F0;">Projeto</h4>

<hr style="border-color:#F8C8DC;" />

<div class="row">
    <div class="col-md-4"
         style="background-color:white; padding:25px; border-radius:15px; box-shadow:0 4px 10px rgba(0,0,0,0.1); border-top:6px solid #F8C8DC;">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label" style="color:#D8B4F8;"></label>
                <input asp-for="Nome" class="form-control" style="border-color:#A8D8F0;" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label" style="color:#D8B4F8;"></label>
                <input asp-for="Descricao" class="form-control" style="border-color:#A8D8F0;" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataInicio" class="control-label" style="color:#D8B4F8;"></label>
                <input asp-for="DataInicio" class="form-control" style="border-color:#A8D8F0;" />
                <span asp-validation-for="DataInicio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataFim" class="control-label" style="color:#D8B4F8;"></label>
                <input asp-for="DataFim" class="form-control" style="border-color:#A8D8F0;" />
                <span asp-validation-for="DataFim" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Pontuacao" class="control-label" style="color:#D8B4F8;"></label>
                <input asp-for="Pontuacao" class="form-control" style="border-color:#A8D8F0;" />
                <span asp-validation-for="Pontuacao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProfessorId" class="control-label" style="color:#D8B4F8;"></label>
                <select asp-for="ProfessorId" class="form-control" asp-items="ViewBag.ProfessorId" style="border-color:#A8D8F0;"></select>
            </div>

            <div class="form-group">
                <label asp-for="CategoriaId" class="control-label" style="color:#D8B4F8;"></label>
                <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId" style="border-color:#A8D8F0;"></select>
            </div>

            <div class="form-group">
                <label asp-for="EquipeId" class="control-label" style="color:#D8B4F8;"></label>
                <select asp-for="EquipeId" class="form-control" asp-items="ViewBag.EquipeId" style="border-color:#A8D8F0;"></select>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Create"
                       class="btn btn-primary"
                       style="background-color:#B7E4C7; border:none; color:#333; border-radius:10px; width:100%; font-weight:bold;" />
            </div>

        </form>

    </div>
</div>

<div style="margin-top:20px;">
    <a asp-action="Index"
       style="color:#A8D8F0; font-weight:bold; text-decoration:none;">
        Back to List
    </a>
</div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}