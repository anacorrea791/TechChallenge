@model IEnumerable<TechChallenge.Models.Projeto>

@{
    ViewData["Title"] = "Index";
}

<div style="background-color:#F5F1E8; min-height:100vh; padding:30px;">

    <h1 style="color:#D8B4F8;">Index</h1>

    <p>
        <a asp-action="Create"
           class="btn"
           style="background-color:#F8C8DC; color:#333; border:none; border-radius:10px; font-weight:bold; padding:10px 20px;">
            Create New
        </a>
    </p>

    <div style="background-color:white; padding:20px; border-radius:15px; box-shadow:0 4px 10px rgba(0,0,0,0.1); border-top:6px solid #A8D8F0;">

        <table class="table">

            <thead style="background-color:#D8B4F8;">

                <tr>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.Nome)
                    </th>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.Descricao)
                    </th>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.DataInicio)
                    </th>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.DataFim)
                    </th>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.Pontuacao)
                    </th>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.Professor)
                    </th>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.Categoria)
                    </th>

                    <th style="color:white;">
                        @Html.DisplayNameFor(model => model.Equipe)
                    </th>

                    <th style="color:white;"></th>

                </tr>

            </thead>

            <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.Nome)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Descricao)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.DataInicio)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.DataFim)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Pontuacao)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Professor.Email)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Categoria.Nome)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Equipe.Nome)
                    </td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           style="color:#B7E4C7; font-weight:bold; text-decoration:none;">
                            Edit
                        </a>

                        <span style="color:#F8C8DC;"> | </span>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           style="color:#A8D8F0; font-weight:bold; text-decoration:none;">
                            Details
                        </a>

                        <span style="color:#F8C8DC;"> | </span>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           style="color:#D8B4F8; font-weight:bold; text-decoration:none;">
                            Delete
                        </a>

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>