@model TechChallenge.Professor

@{
    ViewData["Title"] = "Create";
}

<div style="
    background-color:#F5F1E8;
    min-height:100vh;
    padding:30px;
">

    <h1 style="color:#D8B4F8;">
        Create
    </h1>

    <h4 style="color:#A8D8F0;">
        Professor
    </h4>

    <hr style="border-color:#F8C8DC;" />

    <div class="row">

        <div class="col-md-4"
             style="
             background-color:white;
             padding:25px;
             border-radius:15px;
             box-shadow:0 4px 10px rgba(0,0,0,0.1);
             border-top:6px solid #F8C8DC;
             ">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">

                    <label asp-for="Nome"
                           class="control-label"
                           style="color:#D8B4F8;">
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           style="border-color:#A8D8F0;" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Email"
                           class="control-label"
                           style="color:#D8B4F8;">
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           style="border-color:#A8D8F0;" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Especialidade"
                           class="control-label"
                           style="color:#D8B4F8;">
                    </label>

                    <input asp-for="Especialidade"
                           class="form-control"
                           style="border-color:#A8D8F0;" />

                    <span asp-validation-for="Especialidade"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="DataContratacao"
                           class="control-label"
                           style="color:#D8B4F8;">
                    </label>

                    <input asp-for="DataContratacao"
                           class="form-control"
                           style="border-color:#A8D8F0;" />

                    <span asp-validation-for="DataContratacao"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group form-check"
                     style="
                     background-color:#F8C8DC;
                     padding:10px;
                     border-radius:10px;
                     margin-top:15px;
                     ">

                    <label class="form-check-label">

                        <input class="form-check-input" asp-for="Ativo" />

                        @Html.DisplayNameFor(model => model.Ativo)

                    </label>

                </div>

                <div class="form-group" style="margin-top:15px;">

                    <input type="submit"
                           value="Create"
                           class="btn btn-primary"
                           style="
                           background-color:#B7E4C7;
                           border:none;
                           color:#333;
                           border-radius:10px;
                           width:100%;
                           font-weight:bold;
                           " />

                </div>

            </form>

        </div>

    </div>

    <div style="margin-top:20px;">

        <a asp-action="Index"
           style="
           color:#A8D8F0;
           font-weight:bold;
           text-decoration:none;
           ">
            Back to List
        </a>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}