@model TechChallenge.Models.Equipe

@{
    ViewData["Title"] = "Delete";
}

<div style="
    background-color:#F5F1E8;
    min-height:100vh;
    padding:30px;
">

    <h1 style="color:#D8B4F8;">
        Delete
    </h1>

    <h4 style="color:#A8D8F0;">
        Equipe
    </h4>

    <hr style="border-color:#F8C8DC;" />

    <div style="
        background-color:white;
        padding:25px;
        border-radius:15px;
        box-shadow:0 4px 10px rgba(0,0,0,0.1);
        border-top:6px solid #F8C8DC;
        max-width:500px;
    ">

        <h5 style="color:#D8B4F8;">
            Tem certeza que deseja excluir esta equipe?
        </h5>

        <hr style="border-color:#A8D8F0;" />

        <dl class="row">

            <dt class="col-sm-4" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.Nome)
            </dt>

            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Nome)
            </dd>


            <dt class="col-sm-4" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.Descricao)
            </dt>

            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Descricao)
            </dd>


            <dt class="col-sm-4" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.DataCriacao)
            </dt>

            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.DataCriacao)
            </dd>


            <dt class="col-sm-4" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.Ativa)
            </dt>

            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Ativa)
            </dd>

        </dl>

        <form asp-action="Delete">

            <input type="hidden" asp-for="Id" />

            <input type="submit"
                   value="Delete"
                   class="btn btn-danger"
                   style="
                   background-color:#F8C8DC;
                   border:none;
                   color:#333;
                   border-radius:10px;
                   padding:10px 25px;
                   font-weight:bold;
                   " />

            <span style="color:#A8D8F0;"> | </span>

            <a asp-action="Index"
               style="
               color:#A8D8F0;
               font-weight:bold;
               text-decoration:none;
               ">
                Back to List
            </a>

        </form>

    </div>

</div>