@model TechChallenge.Models.Equipe

@{
    ViewData["Title"] = "Details";
}

<div style="
    background-color:#F5F1E8;
    min-height:100vh;
    padding:30px;
">

    <h1 style="color:#D8B4F8;">
        Details
    </h1>

    <div style="
        background-color:white;
        padding:30px;
        border-radius:20px;
        box-shadow:0 4px 10px rgba(0,0,0,0.1);
        border-top:6px solid #F8C8DC;
    ">

        <h4 style="color:#A8D8F0;">
            Equipe
        </h4>

        <hr style="border-color:#F8C8DC;" />

        <dl class="row">

            <dt class="col-sm-2" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.Nome)
            </dt>

            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Nome)
            </dd>

            <dt class="col-sm-2" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.Descricao)
            </dt>

            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Descricao)
            </dd>

            <dt class="col-sm-2" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.DataCriacao)
            </dt>

            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DataCriacao)
            </dd>

            <dt class="col-sm-2" style="color:#D8B4F8;">
                @Html.DisplayNameFor(model => model.Ativa)
            </dt>

            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Ativa)
            </dd>

        </dl>

    </div>

    <div style="margin-top:20px;">

        <a asp-action="Edit"
           asp-route-id="@Model?.Id"
           style="
           color:#B7E4C7;
           font-weight:bold;
           text-decoration:none;
           ">
            Edit
        </a>

        <span style="color:#F8C8DC;"> | </span>

        <a asp-action="Index"
           style="
           color:#A8D8F0;
           font-weight:bold;
           text-decoration:none;
           ">
            Back to List
        </a>

    </div>

</div>