@model TechChallenge.Aluno

@{
    ViewData["Title"] = "Detalhes";
}

<h1 class="text-center mb-4" style="color:#8A5A9E;">
    👨‍🎓 Detalhes do Aluno
</h1>

<div class="shadow rounded p-4" style="background-color:white;">

    <h4 style="color:#8A5A9E;">Informações do Aluno</h4>

    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Telefone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Telefone)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataNascimento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataNascimento)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataCadastro)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataCadastro)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ativo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ativo)
        </dd>

    </dl>

</div>

<br />

<div>

    <a asp-action="Edit"
       asp-route-id="@Model?.Id"
       class="btn"
       style="background-color:#A8D8F0; color:white;">
        ✏️ Editar
    </a>

    <a asp-action="Index"
       class="btn"
       style="background-color:#F8C8DC; color:white;">
        ⬅ Voltar
    </a>

</div>