@model TechChallenge.Aluno

@{
    ViewData["Title"] = "Excluir Aluno";
}

<h1 class="text-center mb-4" style="color:#8A5A9E;">
    🗑️ Excluir Aluno
</h1>

<h4 style="color:#8A5A9E;">Tem certeza que deseja excluir este aluno?</h4>

<hr />

<div class="shadow rounded p-4 mb-4" style="background-color:white;">

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Telefone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Telefone)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataNascimento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataNascimento)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ativo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ativo)
        </dd>

    </dl>

</div>

<form asp-action="Delete">

    <input type="hidden" asp-for="Id" />

    <input type="submit"
           value="Excluir"
           class="btn"
           style="background-color:#F8C8DC; color:white;" />

    <a asp-action="Index"
       class="btn"
       style="background-color:#A8D8F0; color:white;">
        ⬅ Voltar
    </a>

</form>