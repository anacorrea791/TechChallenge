@model IEnumerable<TechChallenge.Aluno>

@{
    ViewData["Title"] = "Alunos";
}

<h1 class="text-center mb-4" style="color:#8A5A9E;">
    👨‍🎓 Alunos
</h1>

<p>
    <a asp-action="Create"
       class="btn"
       style="background-color:#F8C8DC; color:white;">
        ➕ Novo Aluno
    </a>
</p>

<table class="table table-hover table-bordered shadow">

    <thead style="background-color:#D8B4F8; color:white;">

        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataNascimento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataCadastro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ativo)
            </th>
            <th>Ações</th>
        </tr>

    </thead>

    <tbody>

@foreach (var item in Model)
{
        <tr>

            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Telefone)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.DataNascimento)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.DataCadastro)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Ativo)
            </td>

            <td>

                <a asp-action="Edit"
                   asp-route-id="@item.Id"
                   class="btn btn-sm"
                   style="background-color:#A8D8F0; color:white;">
                    ✏️ Editar
                </a>

                <a asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-sm"
                   style="background-color:#B7E4C7; color:white;">
                    👁 Detalhes
                </a>

                <a asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-sm"
                   style="background-color:#F8C8DC; color:white;">
                    🗑 Excluir
                </a>

            </td>

        </tr>
}

    </tbody>

</table>