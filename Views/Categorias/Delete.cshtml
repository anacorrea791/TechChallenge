@model TechChallenge.Categoria

@{
    ViewData["Title"] = "Delete";
}

<div style="
    background-color:#F5F1E8;
    min-height:100vh;
    padding:30px;
">

    <form asp-action="Delete">

        <input type="hidden" asp-for="Id" />

        <input type="submit" 
               value="Delete" 
               class="btn btn-danger"
               style="
               background-color:#F8C8DC;
               border:none;
               color:#333;
               border-radius:10px;
               font-weight:bold;
               padding:10px 25px;
               " />

        <span style="color:#A8D8F0;"> | </span>

        <a asp-action="Index"
           style="
           color:#A8D8F0;
           font-weight:bold;
           text-decoration:none;
           ">
            Back to List
        </a>

    </form>

</div>
<div>
    <h4>Categoria</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cor)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ativa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ativa)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataCadastro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataCadastro)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
