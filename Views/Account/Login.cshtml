@model TechChallenge.LoginViewModel;

@{
    ViewData["Title"] = "Login";
}

<div style="
    min-height: 100vh;
    background-color: #F5F1E8;
    display: flex;
    justify-content: center;
    align-items: center;
">

    <div style="
        background-color: white;
        width: 380px;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    ">

        <h2 class="text-center mb-4" style="color:#D8B4F8;">
            Login
        </h2>

        <div class="mb-3">
            <label asp-for="Senha" class="form-label"></label>

            <input asp-for="Senha" 
                   class="form-control"
                   type="password"
                   style="border-color:#A8D8F0;" />

            <span asp-validation-for="Senha" 
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <input asp-for="Lembrar" 
                   type="checkbox" />

            <label asp-for="Lembrar">
                Lembrar-me
            </label>
        </div>


        <button type="submit"
                class="btn w-100"
                style="
                    background-color:#B7E4C7;
                    border:none;
                    border-radius:10px;
                    padding:10px;
                    font-weight:bold;
                ">
            Entrar
        </button>


        <button type="button"
                class="btn w-100 mt-3"
                style="
                    background-color:#F8C8DC;
                    border:none;
                    border-radius:10px;
                    padding:10px;
                    font-weight:bold;
                ">
            Novo Aluno
        </button>

    </div>

</div>